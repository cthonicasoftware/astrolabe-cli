# Normalize line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Source and text files: always LF in the working tree.
*.go      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.svg     text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Shell scripts must be LF or they break on Linux.
*.sh text eol=lf

# PowerShell scripts: CRLF for native Windows tooling.
*.ps1 text eol=crlf

# Treat as binary (no EOL conversion, no diff).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
